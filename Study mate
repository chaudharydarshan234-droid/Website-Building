<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>StudyMate — Study Smarter. Understand Faster.</title>
<meta name="description" content="An AI tutor that explains questions step by step and summarizes your notes.">
<style>
:root{--bg:#f7f8fc;--card:#fff;--text:#16192b;--muted:#5d637a;--line:#e3e6f0;--brand:#4f46e5;--brand2:#7c3aed;--ok:#0f9d6b;--warn:#b45309;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#0e1020;--card:#171a30;--text:#eceefb;--muted:#a0a6c4;--line:#2a2e4d;--brand:#818cf8;--brand2:#a78bfa;--ok:#34d399;--warn:#fbbf24;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
a{color:inherit;text-decoration:none}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
header{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;height:60px}
.logo{font-weight:800;font-size:1.1rem}.logo span{color:var(--brand)}
nav .links{display:flex;gap:18px;align-items:center;font-size:.95rem;color:var(--muted)}
nav .links a:hover{color:var(--text)}
.btn{display:inline-block;border:0;cursor:pointer;font:inherit;font-weight:600;padding:10px 18px;border-radius:10px;background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff}
.btn.ghost{background:transparent;color:var(--text);border:1px solid var(--line)}
.btn:disabled{opacity:.6;cursor:wait}
.hero{padding:70px 0 40px;text-align:center}
.pill{display:inline-block;font-size:.8rem;padding:4px 12px;border:1px solid var(--line);border-radius:99px;color:var(--muted);background:var(--card)}
h1{font-size:clamp(2.1rem,6vw,3.6rem);line-height:1.1;margin:18px 0 12px;letter-spacing:-.02em}
h1 em{font-style:normal;background:linear-gradient(135deg,var(--brand),var(--brand2));-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{max-width:560px;margin:0 auto 26px;color:var(--muted);font-size:1.1rem}
.cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.demo{margin:40px auto 0;max-width:640px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px}
.demo h4{margin:0 0 8px;font-size:.8rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.demo ol{margin:8px 0;padding-left:20px}
code,.mono{font-family:ui-monospace,Menlo,Consolas,monospace;background:color-mix(in srgb,var(--brand) 10%,transparent);padding:1px 6px;border-radius:5px;font-size:.92em}
.note{color:var(--warn);font-size:.9rem}
section.block{padding:50px 0}
h2{font-size:1.8rem;margin:0 0 24px;letter-spacing:-.01em}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;transition:transform .15s,border-color .15s}
a.card:hover{transform:translateY(-3px);border-color:var(--brand)}
.card h3{margin:0 0 6px;font-size:1.05rem}.card p{margin:0;color:var(--muted);font-size:.95rem}
.ico{font-size:1.5rem;margin-bottom:8px}
.steps{counter-reset:s}.steps .card::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--brand);color:#fff;font-weight:700;margin-bottom:10px}
.tool{padding:36px 0 60px;display:grid;gap:20px;grid-template-columns:1fr}
@media(min-width:860px){.tool.two{grid-template-columns:1.6fr 1fr}}
label{display:block;font-size:.85rem;font-weight:600;margin:0 0 6px;color:var(--muted)}
select,textarea{width:100%;font:inherit;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
textarea{min-height:150px;resize:vertical}
select:focus,textarea:focus{outline:2px solid var(--brand);outline-offset:1px}
.row{display:grid;gap:12px;grid-template-columns:1fr 1fr;margin-bottom:14px}
.out{margin-top:18px;border-top:1px dashed var(--line);padding-top:16px}
.out h4{margin:14px 0 4px;color:var(--brand)}.out ul,.out ol{margin:4px 0;padding-left:22px}
.hist button{display:block;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line);padding:9px 0;color:var(--text);font:inherit;font-size:.92rem;cursor:pointer}
.hist button:hover{color:var(--brand)}
.muted{color:var(--muted);font-size:.9rem}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:.9rem}
.view{display:none}.view.on{display:block}
</style>
</head>
<body>
<header><div class="wrap"><nav>
  <a class="logo" href="#/">Study<span>Mate</span></a>
  <div class="links"><a href="#/tutor">AI Tutor</a><a href="#/summarizer">Summarizer</a></div>
</nav></div></header>

<!-- HOME -->
<main id="home" class="view on">
<div class="wrap">
  <div class="hero">
    <span class="pill">Built for college students</span>
    <h1>Study Smarter.<br><em>Understand Faster.</em></h1>
    <p class="sub">Your personal AI tutor to explain difficult questions, summarize notes, and help you prepare for exams.</p>
    <div class="cta"><a class="btn" href="#/tutor">Open tutor</a><a class="btn ghost" href="#/summarizer">Summarize notes</a></div>
    <div class="demo">
      <h4>Example · Mechanical Engineering</h4>
      <strong>A Carnot engine works between 527°C and 27°C. Find its efficiency.</strong>
      <ol><li>Convert to kelvin: <code>T₁ = 800 K</code>, <code>T₂ = 300 K</code></li>
      <li>Use <code>η = 1 − T₂/T₁ = 1 − 0.375</code></li></ol>
      <strong>Answer: 62.5%</strong>
      <p class="note">Common mistake: using °C directly gives ≈94.9%, which is wrong.</p>
    </div>
  </div>
  <section class="block"><h2>Everything you need between lecture and exam</h2>
  <div class="grid">
    <a class="card" href="#/tutor"><div class="ico">🧠</div><h3>AI Question Solver</h3><p>Clear explanations tuned to your subject and level.</p></a>
    <a class="card" href="#/summarizer"><div class="ico">📝</div><h3>Smart Notes Summarizer</h3><p>Main idea, definitions, formulas and revision points.</p></a>
    <a class="card" href="#/tutor?style=steps"><div class="ico">🪜</div><h3>Step-by-Step</h3><p>Every calculation broken into numbered steps.</p></a>
    <a class="card" href="#/tutor?style=exam"><div class="ico">🎯</div><h3>Exam Preparation</h3><p>Exam-ready answers with the key points examiners want.</p></a>
  </div></section>
  <section class="block"><h2>Subjects</h2>
  <div class="grid">
    <a class="card" href="#/tutor?subject=Physics"><h3>Physics</h3><p>Laws of motion, work &amp; energy, electrostatics.</p></a>
    <a class="card" href="#/tutor?subject=Mathematics"><h3>Mathematics</h3><p>Differentiation, integration, matrices.</p></a>
    <a class="card" href="#/tutor?subject=Chemistry"><h3>Chemistry</h3><p>Gas laws, bonding, thermochemistry.</p></a>
    <a class="card" href="#/tutor?subject=Computer Science"><h3>Computer Science</h3><p>Big-O, sorting, recursion.</p></a>
    <a class="card" href="#/tutor?subject=Mechanical Engineering"><h3>Mechanical Eng.</h3><p>Thermodynamics, Carnot cycle, stress &amp; strain.</p></a>
  </div></section>
  <section class="block"><h2>From confused to confident in three steps</h2>
  <div class="grid steps">
    <div class="card"><h3>Enter a question</h3><p>Type any academic question, pick a subject and style.</p></div>
    <div class="card"><h3>Get an explanation</h3><p>Receive formulas, worked steps and examples.</p></div>
    <div class="card"><h3>Understand the concept</h3><p>Ask follow-ups and revise with confidence.</p></div>
  </div></section>
</div></main>

<!-- TUTOR -->
<main id="tutor" class="view"><div class="wrap">
  <h2 style="margin-top:36px">AI Tutor</h2>
  <div class="tool two">
    <div class="card">
      <div class="row">
        <div><label for="subject">Subject</label><select id="subject">
          <option>Physics</option><option>Mathematics</option><option>Chemistry</option><option>Computer Science</option><option>Mechanical Engineering</option></select></div>
        <div><label for="style">Explanation style</label><select id="style">
          <option value="simple">Simple</option><option value="steps">Step-by-step</option><option value="exam">Exam answer</option></select></div>
      </div>
      <label for="q">Your question</label>
      <textarea id="q" placeholder="e.g. Differentiate y = x² · sin(x) with respect to x"></textarea>
      <p style="margin:12px 0 0"><button class="btn" id="ask">Ask AI</button></p>
      <div class="out" id="answer" hidden></div>
    </div>
    <div class="card hist"><h3 style="margin-top:0">Recent questions</h3><div id="hist" class="muted">Nothing yet.</div>
      <p style="margin:12px 0 0"><button class="btn ghost" id="clear" style="width:auto;padding:6px 12px">Clear</button></p></div>
  </div>
</div></main>

<!-- SUMMARIZER -->
<main id="summarizer" class="view"><div class="wrap">
  <h2 style="margin-top:36px">Notes Summarizer</h2>
  <div class="tool">
    <div class="card">
      <label for="notes">Paste your lecture notes</label>
      <textarea id="notes" style="min-height:220px" placeholder="Paste at least a few sentences…"></textarea>
      <p style="margin:12px 0 0"><button class="btn" id="sum">Summarize</button> <button class="btn ghost" id="sample">Use sample</button></p>
      <div class="out" id="summary" hidden></div>
    </div>
  </div>
</div></main>

<footer><div class="wrap">StudyMate is a college project exploring how language models help students learn. Questions are saved only in this browser. © 2026</div></footer>

<script>
const $=s=>document.querySelector(s);
const esc=t=>t.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* ---------- Router: #/  #/tutor  #/summarizer (+ ?subject=&style=) ---------- */
function route(){
  const [path,qs]=(location.hash.replace(/^#\/?/,'')||'').split('?');
  const view=['tutor','summarizer'].includes(path)?path:'home';
  document.querySelectorAll('.view').forEach(v=>v.classList.toggle('on',v.id===view));
  const p=new URLSearchParams(qs||'');
  if(view==='tutor'){ if(p.get('subject'))$('#subject').value=p.get('subject'); if(p.get('style'))$('#style').value=p.get('style'); renderHist(); }
  window.scrollTo(0,0);
}
addEventListener('hashchange',route);

/* ---------- History (localStorage, safe if blocked) ---------- */
const KEY='studymate-history';
const load=()=>{try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}};
const save=a=>{try{localStorage.setItem(KEY,JSON.stringify(a.slice(0,10)))}catch(e){}};
function renderHist(){
  const h=load(), box=$('#hist');
  box.innerHTML=h.length?'':'Nothing yet.';
  h.forEach(x=>{const b=document.createElement('button');b.textContent=x.q;
    b.onclick=()=>{$('#q').value=x.q;$('#subject').value=x.subject;$('#style').value=x.style;show(x.a)};box.appendChild(b)});
}
$('#clear').onclick=()=>{save([]);renderHist()};

/* ---------- Tiny markdown renderer (bold, lists, headings) ---------- */
function md(t){
  let html='',list=null;
  const close=()=>{if(list){html+=`</${list}>`;list=null}};
  esc(t).split('\n').forEach(l=>{
    l=l.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/`(.+?)`/g,'<code>$1</code>');
    let m;
    if(m=l.match(/^#{1,3}\s+(.*)/)){close();html+=`<h4>${m[1]}</h4>`}
    else if(m=l.match(/^\d+[.)]\s+(.*)/)){if(list!=='ol'){close();html+='<ol>';list='ol'}html+=`<li>${m[1]}</li>`}
    else if(m=l.match(/^[-*•]\s+(.*)/)){if(list!=='ul'){close();html+='<ul>';list='ul'}html+=`<li>${m[1]}</li>`}
    else if(l.trim()){close();html+=`<p>${l}</p>`}
  });close();return html;
}
function show(a){const o=$('#answer');o.hidden=false;o.innerHTML=md(a)}

/* ---------- AI call ----------
   Never put an API key in front-end code. Point ENDPOINT at your own backend
   (e.g. a Netlify/Vercel function) that holds the key and calls an LLM.
   Expected: POST {question, subject, style}  ->  {answer: "markdown text"}
   If no backend is found, a built-in demo answer is shown instead. */
const ENDPOINT='/api/ask';
async function askAI(question,subject,style){
  try{
    const r=await fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question,subject,style})});
    if(!r.ok)throw 0;
    const d=await r.json(); if(d.answer)return d.answer; throw 0;
  }catch(e){
    return `**Demo mode** — no AI backend is connected yet, so this is a placeholder answer.\n\n### Your question\n${question}\n\n### How to approach it (${subject})\n1. Write down what is given and what is asked.\n2. Identify the relevant law or formula.\n3. Substitute values with correct units.\n4. Check that the result makes sense.\n\nConnect \`${ENDPOINT}\` to a language model to get real, worked solutions.`;
  }
}
$('#ask').onclick=async()=>{
  const q=$('#q').value.trim(); if(!q)return $('#q').focus();
  const subject=$('#subject').value, style=$('#style').value, b=$('#ask');
  b.disabled=true;b.textContent='Thinking…';
  const a=await askAI(q,subject,style);
  show(a); b.disabled=false;b.textContent='Ask AI';
  save([{q,subject,style,a},...load().filter(x=>x.q!==q)]); renderHist();
};

/* ---------- Notes summarizer (runs fully in the browser) ---------- */
const STOP=new Set('a an the and or but of to in on for with is are was were be been it this that as at by from which these those can will has have had not into also than then so such its their there'.split(' '));
function summarize(text){
  const sents=text.replace(/\s+/g,' ').match(/[^.!?]+[.!?]*/g)?.map(s=>s.trim()).filter(s=>s.length>25)||[];
  if(sents.length<3)return null;
  const freq={};
  text.toLowerCase().match(/[a-z]{3,}/g).forEach(w=>{if(!STOP.has(w))freq[w]=(freq[w]||0)+1});
  const score=s=>{const w=s.toLowerCase().match(/[a-z]{3,}/g)||[];return w.reduce((n,x)=>n+(freq[x]||0),0)/Math.sqrt(w.length||1)};
  const ranked=sents.map((s,i)=>({s,i,sc:score(s)})).sort((a,b)=>b.sc-a.sc);
  const main=ranked[0].s;
  const pts=ranked.slice(0,5).sort((a,b)=>a.i-b.i).map(x=>x.s);
  const defs=sents.filter(s=>/\b(is defined as|refers to|is called|means|is the)\b/i.test(s)).slice(0,4);
  const formulas=[...new Set((text.match(/[^\n.]*[A-Za-zΔηΣ][^\n=]{0,15}=[^\n]{1,40}/g)||[]).map(s=>s.trim()))].slice(0,5);
  return {main,defs,formulas,pts};
}
$('#sum').onclick=()=>{
  const r=summarize($('#notes').value), o=$('#summary'); o.hidden=false;
  if(!r){o.innerHTML='<p class="muted">Please paste a few full sentences of notes first.</p>';return}
  const ul=a=>a.length?'<ul>'+a.map(x=>`<li>${esc(x)}</li>`).join('')+'</ul>':'<p class="muted">None detected.</p>';
  o.innerHTML=`<h4>Main idea</h4><p>${esc(r.main)}</p><h4>Key definitions</h4>${ul(r.defs)}<h4>Formulas</h4>${ul(r.formulas)}<h4>Quick revision points</h4>${ul(r.pts)}`;
};
$('#sample').onclick=()=>{$('#notes').value=`The Carnot cycle is a theoretical thermodynamic cycle that gives the maximum possible efficiency for a heat engine. Efficiency refers to the fraction of heat input converted into useful work. A Carnot engine operates between a hot source at temperature T1 and a cold sink at temperature T2. The efficiency is given by η = 1 - T2/T1, where temperatures must be in kelvin. No real engine can be more efficient than a Carnot engine working between the same two temperatures. Increasing the source temperature or lowering the sink temperature raises the efficiency. A common mistake is using Celsius instead of kelvin in the formula.`};

route();
</script>
</body>
</html>
